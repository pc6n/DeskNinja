{
  "name": "deskninja",
  "version": "0.2.0",
  "private": true,
  "description": "DeskNinja monorepo",
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter './packages/*' build && pnpm --filter @deskninja/desktop dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  }
}
