{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskNinja",
  "version": "0.2.0",
  "identifier": "com.deskninja.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskNinja",
        "width": 960,
        "height": 720,
        "resizable": true
      },
      {
        "label": "quick-panel",
        "title": "DeskNinja Quick Panel",
        "width": 720,
        "height": 420,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
