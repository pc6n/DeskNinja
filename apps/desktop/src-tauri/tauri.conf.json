{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskNinja",
  "version": "0.3.0",
  "identifier": "com.deskninja.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DeskNinja",
        "width": 960,
        "height": 720,
        "visible": false,
        "resizable": true
      },
      {
        "label": "quick-panel",
        "title": "DeskNinja",
        "width": 480,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "action-menu",
        "title": "DeskNinja Actions",
        "width": 400,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
